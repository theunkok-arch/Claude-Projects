# Kopieer naar .env voor lokaal draaien met `netlify dev`.
# In productie horen deze uitsluitend in de Netlify-omgevingsvariabelen,
# nooit in de frontend en nooit in git.

AIRTABLE_API_KEY=pat_xxx
AIRTABLE_BASE_ID=appSAz5sjFyPm4e0g

# Gedeeld wachtwoord voor de interne app. Beschermt alle kandidaatgegevens.
ATS_APP_PASSWORD=kies-iets-langs

# Ondertekent de sessiecookies van het klantportaal op /klant.
# Minimaal 32 tekens willekeurig. Wijzigen logt alle klanten meteen uit.
PORTAL_SESSION_SECRET=lang-en-willekeurig-minstens-tweeendertig-tekens

# Waarmee de outreach-skill in Cowork de fase van een aanmelding terugmeldt.
# Kan bewust maar één ding: POST /api/outreach. Geen leesrechten op kandidaten.
OUTREACH_KEY=lang-en-willekeurig
